---
import '../styles/global.css';

import GiftsSection from '../components/GiftsSection.astro';
import Hero from '../components/Hero.astro';
import HowToContribute from '../components/HowToContribute.astro';
import ThankYouFooter from '../components/ThankYouFooter.astro';
import { siteConfig } from '../config/site';
import ContributionDialog from '../features/contributions/presentation/ContributionDialog.astro';
import { giftRepository } from '../features/gifts';

const gifts = await giftRepository.list();
---

<html lang="es-PY">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={siteConfig.pageDescription} />
		<meta name="robots" content={siteConfig.robots} />
		<title>{siteConfig.pageTitle}</title>
	</head>
	<body>
		<p class="prototype-notice" role="status">{siteConfig.prototypeNotice}</p>
		<main>
			<Hero
				coupleNames={siteConfig.coupleNames}
				weddingDate={siteConfig.weddingDate}
				weddingDateIso={siteConfig.weddingDateIso}
				heroEyebrow={siteConfig.heroEyebrow}
				heroSubtitle={siteConfig.heroSubtitle}
				heroCta={siteConfig.heroCta}
			/>
			<HowToContribute
				eyebrow={siteConfig.contributionEyebrow}
				title={siteConfig.contributionTitle}
				intro={siteConfig.contributionIntro}
				steps={siteConfig.contributionSteps}
			/>
			<GiftsSection
				eyebrow={siteConfig.giftsEyebrow}
				title={siteConfig.giftsTitle}
				intro={siteConfig.giftsIntro}
				gifts={gifts}
			/>
		</main>
		<ThankYouFooter
			title={siteConfig.thankYouTitle}
			message={siteConfig.thankYouMessage}
			coupleNames={siteConfig.coupleNames}
		/>
		<ContributionDialog
			bankAccount={siteConfig.bankAccount}
			whatsApp={siteConfig.whatsApp}
		/>
	</body>
</html>

<style>
	.prototype-notice {
		position: relative;
		z-index: 10;
		margin: 0;
		padding: var(--space-2) var(--space-page);
		background: var(--color-text);
		color: var(--color-on-accent);
		font-size: var(--font-size-status);
		font-weight: var(--font-weight-bold);
		text-align: center;
	}
</style>
