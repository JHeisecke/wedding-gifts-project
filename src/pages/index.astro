---
import '../styles/global.css';

import GiftsSection from '../components/GiftsSection.astro';
import Hero from '../components/Hero.astro';
import HowToContribute from '../components/HowToContribute.astro';
import ThankYouFooter from '../components/ThankYouFooter.astro';
import { siteConfig } from '../config/site';
import { giftRepository } from '../features/gifts';

const gifts = await giftRepository.list();
---

<html lang="es-PY">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={siteConfig.pageDescription} />
		<title>{siteConfig.pageTitle}</title>
	</head>
	<body>
		<main>
			<Hero
				coupleNames={siteConfig.coupleNames}
				weddingDate={siteConfig.weddingDate}
				weddingDateIso={siteConfig.weddingDateIso}
				heroEyebrow={siteConfig.heroEyebrow}
				heroSubtitle={siteConfig.heroSubtitle}
				heroCta={siteConfig.heroCta}
			/>
			<HowToContribute
				eyebrow={siteConfig.contributionEyebrow}
				title={siteConfig.contributionTitle}
				intro={siteConfig.contributionIntro}
				steps={siteConfig.contributionSteps}
			/>
			<GiftsSection
				eyebrow={siteConfig.giftsEyebrow}
				title={siteConfig.giftsTitle}
				intro={siteConfig.giftsIntro}
				gifts={gifts}
			/>
		</main>
		<ThankYouFooter
			title={siteConfig.thankYouTitle}
			message={siteConfig.thankYouMessage}
			coupleNames={siteConfig.coupleNames}
		/>
	</body>
</html>
