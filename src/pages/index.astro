---
import '../styles/global.css';

import { giftRepository } from '../features/gifts';

const gifts = await giftRepository.list();
---

<html lang="es-PY">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Esqueleto técnico temporal del proyecto de regalos de boda."
		/>
		<title>Wedding Gifts Project</title>
	</head>
	<body>
		<main class="site-shell">
			<p class="eyebrow">Esqueleto técnico</p>
			<h1>Wedding Gifts Project</h1>
			<p class="summary">
				Astro está funcionando. El contenido definitivo se incorporará en los próximos
				entregables.
			</p>
			<p class="technical-status">{gifts.length} regalos temporales cargados.</p>
		</main>
	</body>
</html>

<style>
	.technical-status {
		margin: var(--space-3) 0 0;
		color: var(--color-accent);
		font-size: var(--font-size-status);
		font-weight: var(--font-weight-bold);
	}
</style>
