---
import type { ContributionStep } from '../config/site';

interface Props {
	eyebrow: string;
	title: string;
	intro: string;
	steps: readonly ContributionStep[];
}

const { eyebrow, title, intro, steps } = Astro.props;
---

<section class="how-to" aria-labelledby="how-to-title">
	<div class="how-to__intro">
		<p class="eyebrow">{eyebrow}</p>
		<h2 id="how-to-title">{title}</h2>
		<p>{intro}</p>
	</div>

	<ol class="steps">
		{steps.map((step) => (
			<li class="step">
				<span class="step__number" aria-hidden="true">{step.number}</span>
				<h3>{step.title}</h3>
				<p>{step.description}</p>
			</li>
		))}
	</ol>
</section>

<style>
	.how-to {
		padding: var(--space-section) var(--space-page);
		background: var(--color-surface);
	}

	.how-to__intro,
	.steps {
		width: min(100%, var(--content-width));
		margin-inline: auto;
	}

	.how-to__intro {
		max-width: var(--content-width-narrow);
		text-align: center;
	}

	h2 {
		margin: 0;
		font-family: var(--font-heading);
		font-size: var(--font-size-heading);
		font-weight: var(--font-weight-medium);
		line-height: var(--line-height-tight);
		letter-spacing: var(--letter-spacing-display);
	}

	.how-to__intro > p:last-child {
		margin: var(--space-4) 0 0;
		color: var(--color-text-muted);
		font-size: var(--font-size-body);
		line-height: var(--line-height-body);
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-5);
		padding: 0;
		margin-top: var(--space-7);
		list-style: none;
	}

	.step {
		padding: var(--space-6);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-large);
		background: var(--color-background);
	}

	.step__number {
		color: var(--color-accent);
		font-size: var(--font-size-eyebrow);
		font-weight: var(--font-weight-bold);
		letter-spacing: var(--letter-spacing-eyebrow);
	}

	h3 {
		margin: var(--space-4) 0 0;
		font-family: var(--font-heading);
		font-size: var(--font-size-lead);
		font-weight: var(--font-weight-medium);
	}

	.step p {
		margin: var(--space-3) 0 0;
		color: var(--color-text-muted);
		line-height: var(--line-height-body);
	}

	@media (max-width: 48rem) {
		.steps {
			grid-template-columns: 1fr;
		}
	}
</style>
