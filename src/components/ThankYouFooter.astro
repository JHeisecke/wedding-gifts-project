---
interface Props {
	title: string;
	message: string;
	coupleNames: string;
}

const { title, message, coupleNames } = Astro.props;
---

<footer class="thank-you">
	<div class="thank-you__content">
		<p class="eyebrow">{coupleNames}</p>
		<h2>{title}</h2>
		<p class="thank-you__message">{message}</p>
	</div>
</footer>

<style>
	.thank-you {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: var(--space-section) var(--space-page);
		background: var(--color-accent);
		color: var(--color-on-accent);
		text-align: center;
	}

	.thank-you::before,
	.thank-you::after {
		position: absolute;
		inset: 0;
		content: '';
	}

	.thank-you::before {
		z-index: -2;
		background: url('/images/couple/embrace.webp') center 57% / cover no-repeat;
		opacity: 0.52;
	}

	.thank-you::after {
		z-index: -1;
		background: linear-gradient(180deg, rgb(77 21 34 / 0.76), rgb(51 20 27 / 0.9));
	}

	.thank-you__content {
		position: relative;
		max-width: var(--content-width-narrow);
		margin-inline: auto;
	}

	.eyebrow {
		color: inherit;
		opacity: 0.8;
	}

	h2 {
		margin: 0;
		font-family: var(--font-heading);
		font-size: var(--font-size-heading);
		font-weight: var(--font-weight-medium);
		line-height: var(--line-height-tight);
		letter-spacing: var(--letter-spacing-display);
	}

	.thank-you__message {
		margin: var(--space-4) 0 0;
		font-size: var(--font-size-body);
		line-height: var(--line-height-body);
		opacity: 0.9;
	}
</style>
