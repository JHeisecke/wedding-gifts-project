---
import type { Gift } from '../features/gifts';
import GiftCard from '../features/gifts/presentation/GiftCard.astro';

interface Props {
	eyebrow: string;
	title: string;
	intro: string;
	gifts: readonly Gift[];
}

const { eyebrow, title, intro, gifts } = Astro.props;
---

<section id="regalos" class="gifts" aria-labelledby="gifts-title">
	<div class="gifts__heading">
		<p class="eyebrow">{eyebrow}</p>
		<h2 id="gifts-title">{title}</h2>
		<p>{intro}</p>
	</div>

	<div class="gift-grid" data-gift-count={gifts.length}>
		{gifts.map((gift) => <GiftCard gift={gift} />)}
	</div>
</section>

<style>
	.gifts {
		padding: var(--space-section) var(--space-page);
	}

	.gifts__heading,
	.gift-grid {
		width: min(100%, var(--content-width));
		margin-inline: auto;
	}

	.gifts__heading {
		max-width: var(--content-width-narrow);
		text-align: center;
	}

	h2 {
		margin: 0;
		font-family: var(--font-heading);
		font-size: var(--font-size-heading);
		font-weight: var(--font-weight-medium);
		line-height: var(--line-height-tight);
		letter-spacing: var(--letter-spacing-display);
	}

	.gifts__heading > p:last-child {
		margin: var(--space-4) 0 0;
		color: var(--color-text-muted);
		font-size: var(--font-size-body);
		line-height: var(--line-height-body);
	}

	.gift-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: stretch;
		gap: var(--space-5);
		margin-top: var(--space-7);
	}

	@media (max-width: 62rem) {
		.gift-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 40rem) {
		.gift-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
